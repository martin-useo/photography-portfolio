{
  "name": "photography-portfolio",
  "version": "2.0.0",
  "description": "Portfolio photographique de Martin USEO avec optimisations de performance",
  "main": "index.html",
  "scripts": {
    "start": "http-server -p 8000 -c-1",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/output.css",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/output.css --watch",
    "serve": "python3 -m http.server 8000",
    "generate:thumbs": "node scripts/generate-thumbnails.js",
    "update:images": "node scripts/update-images-config.js",
    "deploy": "bash scripts/deploy.sh",
    "build": "npm run generate:thumbs && npm run build:css"
  },
  "keywords": [
    "photography",
    "portfolio",
    "optimization",
    "lazy-loading",
    "service-worker",
    "performance"
  ],
  "author": "Martin USEO",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/martin-useo/photography-portfolio.git"
  },
  "devDependencies": {
    "exifr": "^7.1.3",
    "http-server": "^14.1.1",
    "sharp": "^0.33.0",
    "tailwindcss": "^3.4.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
